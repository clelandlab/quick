[Unit]
Description=QuICK native C++ TCP board server
Wants=network-online.target
After=network-online.target
Conflicts=quack_server.service qick_pyro.service

[Service]
Type=simple
User=root
Environment=BOARD=ZCU216
EnvironmentFile=/home/xilinx/jupyter_notebooks/quick_server/runtime.env
WorkingDirectory=/home/xilinx/jupyter_notebooks/quick_server
ExecStart=/home/xilinx/jupyter_notebooks/quick_server/bin/quick-server --config /home/xilinx/quick_server.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=multi-user.target
