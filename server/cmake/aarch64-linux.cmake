# Example: cmake -S . -B build-arm -DCMAKE_TOOLCHAIN_FILE=cmake/aarch64-linux.cmake
#          -DQUICK_CROSS_PREFIX=/opt/gcc-arm-10.2-2020.11-x86_64-aarch64-none-linux-gnu/bin/aarch64-none-linux-gnu-
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED QUICK_CROSS_PREFIX)
  set(QUICK_CROSS_PREFIX aarch64-linux-gnu-)
endif()
set(CMAKE_C_COMPILER "${QUICK_CROSS_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "${QUICK_CROSS_PREFIX}g++")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES QUICK_CROSS_PREFIX)
